{
  "name": "@local/dsh-desktop-notify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Windows system notifications for finished turns, user questions, pending approvals, and settled background jobs.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "desktop-notification",
    "toast"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
